@startuml er-state
title bms-state — data model (database "state")

skinparam shadowing false
skinparam defaultFontName Sans
hide circle
hide methods

entity "hives" as hives {
  * hive_id : TEXT <<PK>>
  --
  * status : hive_status
    latitude : DOUBLE PRECISION
    longitude : DOUBLE PRECISION
    speed : DOUBLE PRECISION
    height : DOUBLE PRECISION
    reported_state : reported_state
    last_telemetry_at : TIMESTAMPTZ
  * last_seen_at : TIMESTAMPTZ
  * connected_at : TIMESTAMPTZ
}

entity "ew_zones" as zones {
  * zone_id : UUID <<PK>>
  --
  * latitude : DOUBLE PRECISION
  * longitude : DOUBLE PRECISION
  * radius_km : DOUBLE PRECISION
  * active_from : TIMESTAMPTZ
    active_to : TIMESTAMPTZ
}

entity "alerts" as alerts {
  * alert_id : BIGSERIAL <<PK>>
  --
  * kind : alert_kind
  * hive_id : TEXT <<FK>>
    zone_id : UUID <<FK>>
    other_hive_id : TEXT <<FK>>
    distance_m : DOUBLE PRECISION
  * raised_at : TIMESTAMPTZ
    resolved_at : TIMESTAMPTZ
}

entity "sagas" as sagas {
  * saga_id : BIGINT <<PK>>
  --
  * alert_id : BIGINT
  * hive_id : TEXT
  * other_hive_id : TEXT
  * status : saga_status
    moving_hive_id : TEXT
  * note : TEXT
  * updated_at : TIMESTAMPTZ
}

entity "processed_events" as processed {
  * event_id : UUID <<PK>>
  --
  * processed_at : TIMESTAMPTZ
}

entity "outbox" as outbox {
  * id : BIGSERIAL <<PK>>
  --
  * routing_key : TEXT
  * envelope : JSONB
  * created_at : TIMESTAMPTZ
    published_at : TIMESTAMPTZ
}

alerts }o--|| hives : hive_id
alerts }o--o| hives : other_hive_id
alerts }o--o| zones : zone_id

note bottom of alerts
  zone_entered: zone_id set.
  proximity: other_hive_id, distance_m set,
  hive_id < other_hive_id.
  Open while resolved_at IS NULL.
end note

note bottom of sagas
  Read copy, built from saga.* events
  of bms-deconfliction.
end note

note bottom of outbox
  Transactional outbox: alert.* events,
  published by the relay.
end note

note bottom of zones
  Active while active_to IS NULL.
end note
@enduml
